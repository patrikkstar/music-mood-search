APP_NAME="MLOps Service"
ENVIRONMENT=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql://postgres:postgres@localhost:55432/postgres

# MLflow Tracking Server (UI: http://localhost:5000)
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_NAME=music-tagger
MODEL_ALIAS=champion

# MinIO (S3): используется скриптами из training/ для загрузки датасета.
# Консоль MinIO: http://localhost:9001
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
# Обязательна для скриптов training/ (или передавайте --data): версия данных
# выбирается явно. Новые данные загружаются по новому пути
# .../vN/embeddings.parquet (v3, v4...), старые версии не перезаписываются.
DATASET_URI=s3://datasets/mtg-jamendo-moodtheme/v2/embeddings.parquet

# Учётные данные сервисов в docker compose
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MLFLOW_DB_PASSWORD=mlflow
